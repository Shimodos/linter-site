---
import Icon from './Icon.astro';
const year = new Date().getFullYear();
---

<footer class="border-t border-line dark:border-line-dark">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-6 px-6 py-10 text-sm text-ink-muted dark:text-ink-muted-dark">
    <p class="flex items-center gap-2.5">
      <span class="inline-block size-2.5 rounded-full bg-accent"></span>
      <span>Linter · MIT License · © {year} Alexei Demchenko</span>
    </p>
    <div class="flex items-center gap-5">
      <a href="https://github.com/Shimodos/Linter" class="inline-flex items-center gap-2 transition hover:text-ink dark:hover:text-ink-dark"><Icon name="github" size={16} /> GitHub</a>
    </div>
  </div>
</footer>
