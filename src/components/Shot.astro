---
// A screenshot of the app in a soft frame. The settings window is a classic
// Windows dialog and only exists in a light theme, so one image serves both site themes.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  width: number;
  class?: string;
  loading?: 'lazy' | 'eager';
}

const { src, alt, width, class: className = '', loading = 'lazy' } = Astro.props;
---

<Image
  src={src}
  alt={alt}
  width={width}
  loading={loading}
  class:list={[
    'rounded-xl ring-1 ring-black/8 shadow-[0_30px_60px_-20px_rgba(0,0,0,0.25)] dark:ring-white/10 dark:shadow-[0_30px_60px_-20px_rgba(0,0,0,0.7)]',
    className,
  ]}
/>
