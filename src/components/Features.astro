---
import Icon from './Icon.astro';

const features = [
  { icon: 'keyboard', title: 'Whole phrases, not just a word', text: 'Everything since the last full stop or Enter is converted in one go, spaces included.' },
  { icon: 'undo', title: 'Undo with the same key', text: 'A second press restores the original text and the original layout.' },
  { icon: 'select', title: 'Selected text too', text: 'Select any text, press the hotkey, and it is converted in place.' },
  { icon: 'volume', title: 'A signal instead of a pop-up', text: 'A short sound when a word is not in the dictionary. Nothing steals focus, nothing is auto-corrected.' },
  { icon: 'wand', title: 'One-key fix', text: 'Right after the signal, a key replaces the word with the dictionary’s suggestion.' },
  { icon: 'ban', title: 'Ignore list', text: 'Names, brands and slang: add them with a key or from the tray, and they are never signalled again.' },
  { icon: 'globe', title: 'Any layout you have installed', text: 'It uses the layouts and spelling dictionaries already in Windows. Choose which languages get the signal.' },
  { icon: 'music', title: 'Eight sounds, or your own', text: 'Tick, blip, pop, knock and more, the system beep, or any WAV file. Each one is under half a second.' },
  { icon: 'window', title: 'Stays out of chosen apps', text: 'List the programs where it should do nothing at all: remote desktop, games, terminals.' },
  { icon: 'layers', title: 'Your hotkeys', text: 'Press the key you want in the settings window. Left and right Alt, Ctrl and Shift are told apart.' },
  { icon: 'shield', title: 'Private by design', text: 'No network code, no account, no telemetry. The debug log is off unless you turn it on.' },
  { icon: 'feather', title: 'Small and native', text: 'One C# exe and a folder of sounds. No installer, no background service, no admin rights.' },
] as const;
---

<section id="features" class="border-t border-line dark:border-line-dark">
  <div class="mx-auto max-w-6xl px-6 py-24">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold tracking-wide text-accent uppercase">Features</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-balance sm:text-4xl">Two jobs, done quietly</h2>
    </div>

    <ul class="mt-14 grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      {features.map((f) => (
        <li class="flex gap-4">
          <span class="mt-0.5 grid size-10 shrink-0 place-items-center rounded-xl bg-card text-ink ring-1 ring-line dark:bg-card-dark dark:text-ink-dark dark:ring-line-dark">
            <Icon name={f.icon} size={20} />
          </span>
          <div>
            <h3 class="font-semibold tracking-tight">{f.title}</h3>
            <p class="mt-1.5 text-[15px] leading-relaxed text-ink-muted dark:text-ink-muted-dark">{f.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
