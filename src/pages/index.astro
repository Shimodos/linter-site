---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Features from '../components/Features.astro';
import Screenshots from '../components/Screenshots.astro';
import Faq from '../components/Faq.astro';
import Download from '../components/Download.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Linter — fix the wrong keyboard layout with one key"
  description="A free, open-source tray utility for Windows 10 and 11. Typed in the wrong keyboard layout? One key retypes the phrase in the right one. A quiet signal on misspelled words, a one-key fix, and it never goes online."
>
  <Nav />
  <main>
    <Hero />
    <HowItWorks />
    <Features />
    <Screenshots />
    <Faq />
    <Download />
  </main>
  <Footer />
</Layout>
